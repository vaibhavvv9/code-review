# Server
PORT=8787

# Comma-separated list of allowed origins for CORS.
# The Chrome extension origin looks like: chrome-extension://<your-extension-id>
# During development you can use * to allow all origins.
ALLOWED_ORIGINS=*

# OpenAI (or any OpenAI-compatible gateway)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible gateway instead of api.openai.com.
# For OpenRouter, set:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=

# Optional GitHub token to raise the public API rate limit (60/hr -> 5000/hr).
# Only needs public repo / read access for public PRs. Leave blank to use unauthenticated requests.
GITHUB_TOKEN=
